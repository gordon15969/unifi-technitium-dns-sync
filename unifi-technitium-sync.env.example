# UniFi UDM SE
UNIFI_URL=https://192.168.1.1
UNIFI_API_KEY=replace-with-unifi-api-key
UNIFI_SITE_ID=replace-with-site-uuid

# The legacy stat/sta endpoint is the only one that exposes the DHCP-reported
# `hostname` field; it accepts the same X-API-Key. The official Integration API
# (/proxy/network/integration/v1/sites/{site_id}/clients) returns only `name`
# (the UniFi alias, falling back to hostname).
UNIFI_CLIENTS_PATH=/proxy/network/api/s/default/stat/sta

# Prefer installing the UDM CA certificate and setting UNIFI_CA_FILE.
# For an initial test with the UDM self-signed certificate, set this to false.
UNIFI_VERIFY_TLS=true
# UNIFI_CA_FILE=/etc/unifi-technitium-sync/udm-ca.pem

# Technitium DNS
TECHNITIUM_URL=http://192.168.10.53:5380
TECHNITIUM_API_TOKEN=replace-with-limited-technitium-api-token
TECHNITIUM_VERIFY_TLS=true
# TECHNITIUM_CA_FILE=/etc/unifi-technitium-sync/technitium-ca.pem

# Existing Technitium primary zone; the service does not create the zone.
# home.arpa is the RFC 8375 standard zone for home networks; any zone you
# own (for example lan.example.com) works as well.
DNS_ZONE=home.arpa
DNS_TTL=300

# Timing, in seconds
SYNC_INTERVAL=300
STALE_AFTER=86400
REQUEST_TIMEOUT=20

# Apply an IP change only after the same new address is reported this many
# consecutive polls. Dampens clients whose reported IP flaps. 1 = immediate.
IP_STABLE_POLLS=2

# Name stability. A record is only renamed when the source data changes
# durably (added in 1.3.0):
#   NAME_STABLE_POLLS    sightings of an *edited alias* (the first NAME_FIELDS
#                        entry) before the record is renamed (1 = at once)
#   NAME_DOWNGRADE_POLLS consecutive online polls a client's stored name must go
#                        unreported before a less preferred field, a different
#                        device-announced hostname, or no name may replace it;
#                        288 = 24 h at a 5-minute interval. UniFi's hostname
#                        for some IoT devices alternates between discovery
#                        sources (DHCP, mDNS, UPnP), so keep this high. A newly
#                        set alias always applies at once, and a hostname that
#                        is unique on the network replaces one shared with
#                        other clients at once.
#   NAME_MEMORY_TTL      seconds a client's name is remembered after it was last
#                        seen; keeps de-duplication suffixes stable while a
#                        namesake is offline. 604800 = 7 days; 0 = online only.
# Set 1 / 1 / 0 to restore the pre-1.3.0 behaviour.
NAME_STABLE_POLLS=2
NAME_DOWNGRADE_POLLS=288
NAME_MEMORY_TTL=604800

# Optional comma-separated IPv4 networks. Empty means accept every private/public IPv4
# returned by UniFi. Restricting this to your VLANs is strongly recommended.
ALLOWED_NETWORKS=192.168.10.0/24,192.168.20.0/24,192.168.30.0/24

# Name selection order and optional labels to ignore.
# `name` is the UniFi alias; `hostname` is the DHCP-reported hostname
# (legacy API only), used as a fallback for clients with no alias.
NAME_FIELDS=name,hostname
# Remove a final xx:xx or xx-xx suffix only when it matches the client's MAC.
STRIP_TRAILING_MAC=false
EXCLUDED_NAMES=

# PTR creation is off by default. With CREATE_PTR=true the service keeps a
# matching PTR record for every A record it manages (created on add, removed
# on delete). CREATE_PTR_ZONE=true lets Technitium create missing reverse
# zones automatically. After enabling on an existing installation, run the
# one-time `--backfill-ptr` mode to create PTRs for records that already exist.
CREATE_PTR=false
CREATE_PTR_ZONE=false

STATE_FILE=/var/lib/unifi-technitium-sync/state.json
LOG_LEVEL=INFO

# Optional built-in web UI (README "Web UI"). Off while WEB_LISTEN is empty.
# Set a password first:
#   unifi_technitium_sync.py --config /etc/unifi-technitium-sync/sync.env --set-web-password
# Without a password the UI only starts on 127.0.0.1. WEB_PASSWORD_HASH is
# written by that command (or by the UI's password form); do not edit it by hand.
WEB_LISTEN=
# WEB_TLS_CERT=/etc/unifi-technitium-sync/web.crt
# WEB_TLS_KEY=/etc/unifi-technitium-sync/web.key
